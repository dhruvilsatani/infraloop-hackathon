# Production image: the Angular app is built here and served by the backend, so ONE container on ONE port is the whole site.
#   build:  docker build -f Dockerfile.prod -t infraloop .        (podman works the same)
#   run:    docker run -d --name infraloop -p 127.0.0.1:8000:8000 --env-file .env infraloop
# For local development use docker-compose.yml instead (backend and the Angular dev server as two containers).

FROM node:22-slim AS frontend
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ .
RUN npx ng build

FROM python:3.12-slim

# git is needed to clone public GitHub repos
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN rm -rf /app/frontend
COPY --from=frontend /fe/dist/frontend/browser /app/web/frontend_dist

# run as a normal user; the app only writes its small sqlite file and temp upload folders
RUN useradd --create-home --uid 10001 app && chown -R app:app /app
USER app

ENV INFRALOOP_PUBLIC=1 \
    PYTHONUNBUFFERED=1

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/',timeout=4)" || exit 1
CMD ["python", "-m", "uvicorn", "web.api:app", "--host", "0.0.0.0", "--port", "8000"]
